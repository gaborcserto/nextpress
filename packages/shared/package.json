{
  "name": "@nextpress/shared",
  "version": "1.0.0",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./utils/*": "./src/utils/*",
    "./hooks/*": "./src/hooks/*",
    "./types/*": "./src/types/*"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@nextpress/eslint-config": "*"
  }
}
