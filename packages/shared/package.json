{
  "name": "@nextpress/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./auth-policy": "./src/utils/auth-policy.ts",
    "./slugify": "./src/utils/slugify.ts",
    "./content": "./src/editorial/content.ts",
    "./page-document": "./src/editorial/page-document.ts",
    "./revisions": "./src/editorial/revisions.ts",
    "./media": "./src/media.ts",
    "./utils/*": "./src/utils/*",
    "./api-contracts": "./src/api-contracts.ts",
    "./roles": "./src/roles.ts",
    "./oauth-providers": "./src/oauth-providers.ts",
    "./site-date-time": "./src/site-date-time.ts",
    "./settings-contracts": "./src/settings-contracts.ts",
    "./editorial-contracts": "./src/editorial/editorial-contracts.ts",
    "./working-aggregate": "./src/editorial/working-aggregate.ts",
    "./request-correlation": "./src/request-correlation.ts",
    "./server-logging": "./src/server-logging.ts",
    "./service-unavailable": "./src/service-unavailable.ts"
  },
  "scripts": {
    "lint": "node ../../scripts/readability.mjs --verbose && eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@nextpress/eslint-config": "*"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
