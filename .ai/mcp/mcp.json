{
  "mcpServers": {
    "figma": {
      "command": "bash",
      "args": [".vscode/check-mcp-servers.sh", "figma"]
    },
    "confluence": {
      "command": "bash",
      "args": [".vscode/check-mcp-servers.sh", "confluence"]
    },
    "bitbucket": {
      "command": "bash",
      "args": [".vscode/check-mcp-servers.sh", "bitbucket"]
    },
    "ollama": {
      "command": "bash",
      "args": [".vscode/check-mcp-servers.sh", "ollama"]
    },
    "jira": {
      "command": "bash",
      "args": [".vscode/check-mcp-servers.sh", "jira"]
    },
    "appium-android": {
      "command": "appium-mcp",
      "args": [],
      "env": {
        "ANDROID_HOME": "${env:ANDROID_HOME}",
        "CAPABILITIES_CONFIG": "../apps/wdio-test-mobile-app/config/mcp-capabilities/android-capabilities.json",
        "NO_UI": "true",
        "SCREENSHOTS_DIR": "../apps/wdio-test-mobile-app/report/screenshots"
      }
    },
    "appium-ios": {
      "command": "appium-mcp",
      "args": [],
      "env": {
        "ANDROID_HOME": "${env:ANDROID_HOME}",
        "CAPABILITIES_CONFIG": "../apps/wdio-test-mobile-app/config/mcp-capabilities/ios-capabilities.json",
        "NO_UI": "true",
        "SCREENSHOTS_DIR": "../apps/wdio-test-mobile-app/report/screenshots"
      }
    }
  }
}
