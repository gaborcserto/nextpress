{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "endOfLine": "lf",
  "semi": true,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "sortImports": false,
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.next/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/generated/**",
    "**/*.tsbuildinfo",
    "**/package-lock.json",
    "**/migrations/**",
    "apps/*/public/**",
    "**/vendor/**",
    "**/*.min.*",
    ".notes/**",
    ".references/**"
  ]
}
