{
  "name": "nextpress",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.2.4",
  "engines": {
    "node": "22.x",
    "npm": "10.2.4"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "npm --workspace web run dev",
    "dev:admin": "npm --workspace admin run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "test": "turbo run test",
    "coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "prisma:generate": "turbo run prisma:generate",
    "prisma:migrate": "turbo run prisma:migrate",
    "db:up": "docker compose up -d",
    "bootstrap": "npm run db:up && npm run dev",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@nextpress/eslint-config": "*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.6.0",
    "turbo": "^2.11.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
