{
  "name": "nextpress",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@12.2.2",
  "engines": {
    "node": "24.x",
    "npm": "12.2.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "npm --workspace web run dev",
    "dev:admin": "turbo run dev --parallel --filter=admin --filter=api",
    "build": "turbo run build",
    "lint": "npm run lint:root && turbo run lint",
    "lint:root": "eslint scripts/ \"*.{mjs,cjs}\" --max-warnings 0",
    "lint:fix": "npm run lint:root -- --fix && turbo run lint -- --fix",
    "test": "turbo run test",
    "coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "check:changed": "node scripts/check-changed.mjs",
    "check:changed:test": "node --test scripts/check-changed.test.mjs scripts/quality-files.test.mjs",
    "openapi:validate": "npm --workspace api run openapi:validate",
    "prisma:generate": "turbo run prisma:generate",
    "prisma:migrate": "turbo run prisma:migrate",
    "prisma:validate": "turbo run validate --filter=@nextpress/db",
    "prisma:deploy": "turbo run prisma:deploy",
    "db:up": "docker compose up -d",
    "db:seed": "npm --workspace @nextpress/db run seed",
    "admin:bootstrap": "npm --workspace api run bootstrap:admin",
    "bootstrap": "npm run db:up && npm run dev",
    "prepare": "husky",
    "agents:validate": "node scripts/validate-agent-resources.mjs",
    "agents:test": "node --test scripts/validate-agent-resources.test.mjs",
    "format:changed": "node scripts/check-changed.mjs --format",
    "format:check:changed": "node scripts/check-changed.mjs --format-check",
    "dev:api": "npm --workspace api run dev"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@nextpress/eslint-config": "*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.12",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.6.0",
    "oxfmt": "0.78.0",
    "turbo": "^2.11.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
