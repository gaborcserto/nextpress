{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "inputs": ["$TURBO_DEFAULT$", "apps/admin/.env", "apps/web/.env", "packages/db/.env"],
      "env": [
        "BETTER_AUTH_URL",
        "NEXT_PUBLIC_BETTER_AUTH_URL",
        "NEXT_PUBLIC_ADMIN_URL",

        "APPLE_CLIENT_ID",
        "APPLE_CLIENT_SECRET",

        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",

        "TWITTER_CLIENT_ID",
        "TWITTER_CLIENT_SECRET",

        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",

        "FACEBOOK_CLIENT_ID",
        "FACEBOOK_CLIENT_SECRET",

        "DISCORD_CLIENT_ID",
        "DISCORD_CLIENT_SECRET"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"],
      "inputs": ["$TURBO_DEFAULT$", "apps/admin/.env", "apps/web/.env", "packages/db/.env"],
      "env": [
        "BETTER_AUTH_URL",
        "NEXT_PUBLIC_BETTER_AUTH_URL",
        "NEXT_PUBLIC_ADMIN_URL",

        "DATABASE_URL",

        "APPLE_CLIENT_ID",
        "APPLE_CLIENT_SECRET",

        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",

        "TWITTER_CLIENT_ID",
        "TWITTER_CLIENT_SECRET",

        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",

        "FACEBOOK_CLIENT_ID",
        "FACEBOOK_CLIENT_SECRET",

        "DISCORD_CLIENT_ID",
        "DISCORD_CLIENT_SECRET"
      ]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "apps/admin/.env", "apps/web/.env", "packages/db/.env"],
      "env": [
        "BETTER_AUTH_URL",
        "NEXT_PUBLIC_BETTER_AUTH_URL",
        "NEXT_PUBLIC_ADMIN_URL",

        "DATABASE_URL",
        "BCRYPT_COST",
        "NODE_ENV",
        "NEXT_PUBLIC_SITE_URL",
        "ADMIN_EMAIL",
        "ADMIN_PASSWORD",

        "APPLE_CLIENT_ID",
        "APPLE_CLIENT_SECRET",

        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",

        "TWITTER_CLIENT_ID",
        "TWITTER_CLIENT_SECRET",

        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",

        "FACEBOOK_CLIENT_ID",
        "FACEBOOK_CLIENT_SECRET",

        "DISCORD_CLIENT_ID",
        "DISCORD_CLIENT_SECRET"
      ]
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^test:coverage"],
      "outputs": ["coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "prisma:generate": {
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", "packages/db/.env"],
      "env": ["DATABASE_URL"]
    },
    "prisma:migrate": {
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", "packages/db/.env"]
    }
  }
}
