{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["NEXTPRESS_REQUEST_CORRELATION_SECRET"],
  "globalEnv": [
    "NEXTPRESS_E2E",
    "NEXTPRESS_BACKFILL_DATABASE_NAME",
    "NEXTPRESS_BACKFILL_CLUSTER_ID",
    "NEXTPRESS_BACKFILL_DATABASE_ROLE",
    "NEXTPRESS_PRIVATE_DRAFT_REHEARSAL",
    "NEXTPRESS_PRIVATE_TEST_DATABASE_URL",
    "MEDIA_STORAGE_ROOT",
    "DOCUMENT_UPLOAD_MAX_BYTES",
    "SITE_URL",
    "NEXT_PUBLIC_PREVIEW_ORIGIN",
    "PREVIEW_ADMIN_ORIGIN"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["API_INTERNAL_ORIGIN"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env",
        ".env.local",
        ".env.production",
        ".env.production.local"
      ],
      "env": ["API_INTERNAL_ORIGIN"]
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/admin/.env",
        "$TURBO_ROOT$/apps/web/.env",
        "$TURBO_ROOT$/packages/db/.env",
        "$TURBO_ROOT$/apps/api/.env"
      ],
      "env": [
        "NEXTPRESS_SECURITY_TEST_DATABASE_URL",
        "BETTER_AUTH_URL",
        "BETTER_AUTH_SECRET",
        "NEXT_PUBLIC_BETTER_AUTH_URL",
        "NEXT_PUBLIC_ADMIN_URL",
        "DATABASE_URL",
        "NODE_ENV",
        "NEXT_PUBLIC_SITE_URL",
        "ADMIN_EMAIL",
        "ADMIN_PASSWORD",
        "APPLE_CLIENT_ID",
        "APPLE_CLIENT_SECRET",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "TWITTER_CLIENT_ID",
        "TWITTER_CLIENT_SECRET",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "FACEBOOK_CLIENT_ID",
        "FACEBOOK_CLIENT_SECRET",
        "DISCORD_CLIENT_ID",
        "DISCORD_CLIENT_SECRET",
        "NEXTPRESS_CONTENT_TEST_DATABASE_URL",
        "API_INTERNAL_ORIGIN",
        "NEXTPRESS_E2E_WEB_PRODUCTION",
        "NEXTPRESS_E2E_WEB_ARTIFACT"
      ]
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": [],
      "env": [
        "NEXTPRESS_CONTENT_TEST_DATABASE_URL",
        "DATABASE_URL",
        "VITEST_MAX_WORKERS"
      ]
    },
    "test:coverage": {
      "dependsOn": ["^test:coverage"],
      "outputs": ["coverage/**"],
      "env": [
        "NEXTPRESS_CONTENT_TEST_DATABASE_URL",
        "DATABASE_URL",
        "VITEST_MAX_WORKERS"
      ]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "prisma:generate": {
      "cache": false,
      "env": ["DATABASE_URL", "NODE_ENV"]
    },
    "validate": {
      "cache": false,
      "env": ["DATABASE_URL", "NODE_ENV"]
    },
    "prisma:deploy": {
      "cache": false,
      "env": ["DATABASE_URL", "NODE_ENV"]
    },
    "prisma:migrate": {
      "cache": false,
      "env": ["DATABASE_URL", "NODE_ENV"]
    },
    "@nextpress/db#seed": {
      "cache": false,
      "env": ["ALLOW_DEVELOPMENT_CONTENT_SEED", "DATABASE_URL", "NODE_ENV"]
    }
  },
  "globalDependencies": [
    "packages/eslint-config/**",
    "!packages/eslint-config/.turbo/**",
    "eslint.config.mjs",
    ".oxfmtrc.json",
    "scripts/readability.mjs",
    "scripts/readability-core.mjs",
    "tsconfig.base.json"
  ]
}
