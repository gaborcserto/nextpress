{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname localhost --port 49102",
    "build": "next build --turbopack",
    "start": "next start --port 49102",
    "bootstrap:admin": "tsx --env-file-if-exists=.env scripts/bootstrap-admin.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "openapi:validate": "vitest run src/lib/api/openapi.test.ts",
    "openapi:export": "tsx scripts/export-openapi.ts"
  },
  "dependencies": {
    "@nextpress/db": "*",
    "@nextpress/shared": "*",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.18",
    "next": "^16.4.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "swagger-ui-dist": "5.33.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@nextpress/eslint-config": "*",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.7",
    "eslint-config-turbo": "^2.11.5",
    "openapi-types": "^12.1.3",
    "tsx": "4.23.15",
    "typescript": "^5.9.3"
  }
}
