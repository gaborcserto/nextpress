# Required server-side database URL shared by API, Prisma CLI and seeds.
# This example is for fresh local Compose setup. Keep the existing target
# when using a separately provisioned database. Shell overrides take precedence.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/cms?schema=public

# Authentication. Use the browser-facing Admin origin (HTTPS in production).
# Generate a unique secret of at least 32 characters before signing in.
BETTER_AUTH_URL=http://localhost:49101
BETTER_AUTH_SECRET=

# Request correlation (optional). Set the same random server-only secret of
# at least 32 bytes in API, Admin and Web. Without a valid signature, the API
# generates its own request ID.
NEXTPRESS_REQUEST_CORRELATION_SECRET=

# Administrator setup only. Email is required. A new password must contain
# at least 15 characters. An existing password is preserved on rerun.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional initial site URL stored in site settings by admin:bootstrap.
NEXT_PUBLIC_SITE_URL=
# Keep empty locally. Production admin:bootstrap requires explicit opt-in.
ALLOW_PRODUCTION_ADMIN_SEED=

# OAuth (optional). Enable the provider in settings. Values stored there take
# precedence. Supply any missing client ID and secret through these variables.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Media storage (optional). Defaults to .media in the API working directory.
# Keep it private and persistent. Back it up alongside PostgreSQL.
MEDIA_STORAGE_ROOT=

# Backfill target approval; unset values keep execution closed. Never designate cms.
# Compare these non-secret values with independently provisioned operational evidence.
NEXTPRESS_BACKFILL_DATABASE_NAME=
NEXTPRESS_BACKFILL_CLUSTER_ID=
NEXTPRESS_BACKFILL_DATABASE_ROLE=

# Private draft API rehearsal only; defaults off and always refused in production.
# Also requires the independently verified backfill target identity above.
NEXTPRESS_PRIVATE_DRAFT_REHEARSAL=

# Optional PDF upload cap in bytes. Defaults to 10485760; may be lowered.
# Install qpdf 12.4.2 or newer on the API process PATH to enable PDF uploads.
# DOCUMENT_UPLOAD_MAX_BYTES=10485760
