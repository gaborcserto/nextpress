# Server-only API origin. Required in production.
API_INTERNAL_ORIGIN=http://localhost:49102

# Request correlation (optional). Set the same random server-only secret of
# at least 32 bytes in API, Admin and Web. Without a valid signature, the API
# generates its own request ID.
NEXTPRESS_REQUEST_CORRELATION_SECRET=

# Live Preview (optional). Browser-exposed Web origin set at build time.
NEXT_PUBLIC_PREVIEW_ORIGIN=http://localhost:49100
