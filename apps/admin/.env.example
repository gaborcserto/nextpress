# Local HTTP development. Production requires BETTER_AUTH_URL over HTTPS and a
# unique BETTER_AUTH_SECRET of at least 32 characters. OAuth credentials are
# optional; configure both values for a provider to enable it.
BETTER_AUTH_URL=http://localhost:49101
BETTER_AUTH_SECRET=

NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:49101
NEXT_PUBLIC_ADMIN_URL=http://localhost:49101

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cms?schema=public
# Used only when explicitly running the database seed. No default admin is made.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- GitHub ---
GITHUB_CLIENT_ID=xxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxxxx

# --- Google ---
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx

# --- Discord ---
DISCORD_CLIENT_ID=xxxxxxxx
DISCORD_CLIENT_SECRET=xxxxxxxx

# --- Facebook ---
FACEBOOK_CLIENT_ID=xxxxxxxx
FACEBOOK_CLIENT_SECRET=xxxxxxxx

# --- Twitter / X ---
TWITTER_CLIENT_ID=xxxxxxxx
TWITTER_CLIENT_SECRET=xxxxxxxx

# --- Apple ---
APPLE_CLIENT_ID=xxxxxxxx
APPLE_CLIENT_SECRET=xxxxxxxx
