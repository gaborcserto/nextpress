# Canonical Web origin for metadata. Required in production.
SITE_URL=http://localhost:49100
# Server-only API origin. Required in production.
API_INTERNAL_ORIGIN=http://localhost:49102

# Request correlation (optional). Set the same random server-only secret of
# at least 32 bytes in API, Admin and Web. Without a valid signature, the API
# generates its own request ID.
NEXTPRESS_REQUEST_CORRELATION_SECRET=

# Live Preview. The browser-facing Admin origin used by the frame policy and
# session messaging. Required in production; local development defaults to
# http://localhost:49101 when unset.
PREVIEW_ADMIN_ORIGIN=http://localhost:49101
